{
  "tags": [
    {
      "name": "Events",
      "description": "Manage hostel events"
    }
  ],
  "paths": {
    "/api/events/create": {
      "post": {
        "tags": ["Events"],
        "summary": "Create a new event",
        "description": "Allows authenticated users who own a hostel to create events.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "example": "Pool Party" },
                      "description": { "type": "string", "example": "Event with music and drinks" },
                      "hostel_location": { "type": "boolean", "example": false },
                      "address": {
                        "type": "object",
                        "properties": {
                          "street": { "type": "string", "example": "123 Flower St." },
                          "city": { "type": "string", "example": "New York" },
                          "zip": { "type": "string", "example": "10001" }
                        }
                      },
                      "start_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-12-31T20:00:00Z"
                      },
                      "end_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-12-31T23:00:00Z"
                      },
                      "unlimited_spots": { "type": "boolean", "example": false },
                      "spots_available": { "type": "integer", "example": 50 },
                      "free_entry": { "type": "boolean", "example": false },
                      "price": { "type": "number", "example": 50 },
                      "payment_to_hostel": { "type": "boolean", "example": true },
                      "receive_payment_online": { "type": "boolean", "example": true },
                      "event_recurring": { "type": "boolean", "example": false },
                      "event_frequency": { "type": "string", "example": "monday" },
                      "payment_methods": {
                        "type": "array",
                        "items": { "type": "string", "example": "card" }
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "hostel_location",
                      "start_date",
                      "unlimited_spots",
                      "free_entry",
                      "payment_to_hostel",
                      "event_recurring"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Event images (up to 4 files)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Event created successfully" },
                    "data": { "$ref": "#/components/schemas/Event" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string", "example": "Payment details are required" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "User not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": {
                      "type": "string",
                      "example": "User not authenticated or missing user ID"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "64c3b2c8f1d2a8e7b5a3d1f0" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "hostel_location": { "type": "boolean" },
          "address": {
            "type": "object",
            "properties": {
              "street": { "type": "string" },
              "city": { "type": "string" },
              "zip": { "type": "string" }
            }
          },
          "start_date": { "type": "string", "format": "date-time" },
          "end_date": { "type": "string", "format": "date-time" },
          "photos_last_event": {
            "type": "array",
            "items": { "type": "string" }
          },
          "unlimited_spots": { "type": "boolean" },
          "spots_available": { "type": "integer" },
          "free_entry": { "type": "boolean" },
          "price": { "type": "number" },
          "payment_to_hostel": { "type": "boolean" },
          "receive_payment_online": { "type": "boolean" },
          "event_recurring": { "type": "boolean" },
          "event_frequency": { "type": "string" },
          "payment_methods": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hostel_id": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
